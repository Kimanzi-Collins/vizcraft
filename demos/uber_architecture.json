  "steps": [
    {
      "title": "Rider Requests",
      "description": "The Rider requests a ride through the API Gateway, reaching the Demand Service.",
      "highlight": [
        "rider_app",
        "api_gw",
        "demand"
      ]
    },
    {
      "title": "Driver Updates",
      "description": "Drivers constantly stream their GPS locations via WebSockets to the Supply Service.",
      "highlight": [
        "driver_app",
        "api_gw",
        "supply",
        "redis"
      ]
    },
    {
      "title": "Dispatch Matching",
      "description": "The Dispatch Optimizer matches demand and supply using geospatial data.",
      "highlight": [
        "demand",
        "supply",
        "dispatch",
        "redis"
      ]
    },
    {
      "title": "Trip Execution",
      "description": "Once matched, the Trip Service handles the lifecycle, mapping routes, and collecting payment.",
      "highlight": [
        "trip",
        "maps",
        "payment"
      ]
    },
    {
      "title": "Analytics Logging",
      "description": "All trip events stream through Kafka into Hadoop for machine learning and pricing optimization.",
